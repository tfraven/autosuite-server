# Server Configuration
PORT=5000
NODE_ENV=production

# JWT Authentication
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production
REFRESH_SECRET=your_super_secret_refresh_key_here_change_in_production

# PostgreSQL Database (Neon or self-hosted)
DATABASE_URL="postgresql://user:password@hostname:5432/neondb?sslmode=require"
DIRECT_URL="postgresql://user:password@hostname:5432/neondb?sslmode=require"

# Security & CORS
# Comma-separated allowed origins (e.g. https://dealership.yourdomain.com)
CORS_ORIGIN="http://localhost:5173,https://autosuite-client.vercel.app"

# Audit Logging & Compliance
LOG_RETENTION_DAYS=90
